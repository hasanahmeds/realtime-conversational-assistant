# OpenRouter API Key for diverse model access (e.g. Llama, Claude, DeepSeek)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct Google Gemini API Key fallback (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Active model configured for OpenRouter
OPENROUTER_MODEL=your_model_name_here

# Default fallback system prompt instructions for custom bot personas
DEFAULT_BOT_ROLE=You are a helpful and concise assistant.
